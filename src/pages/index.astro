---
// src/pages/index.astro
import BaseLayout from '../layouts/Layout.astro';
import { boda } from '../data/boda';

import Home from '../components/Home.astro';
import Presentacion from '../components/Presentacion.astro';
import Countdown from '../components/Countdown.astro';
import Location from '../components/Location.astro';
import Program from '../components/Program.astro';
import RSVP from '../components/RSVP.astro';
import Photos from '../components/Photos.astro';
import Closing from '../components/Closing.astro';
import Divider from '../components/Divider.astro';
import Calendar from '../components/Calendar.astro';
import Sugerencia from '../components/Sugerencia.astro';

// Orden de las secciones: para reordenar, agregar o sacar una, se toca solo esta lista.
// (Hero, Details, Calendar, Qr, Header y Footer quedaron fuera porque no se usaban.)
const secciones = [Home, Presentacion, Calendar, Countdown, Location, Sugerencia, RSVP, Photos];
---

<BaseLayout bodyClass="bg-pagina min-h-dvh flex justify-center py-6 px-4 overflow-hidden">

  <!-- Audio de fondo (invisible) -->
  <audio id="musica-fondo" loop preload="metadata">
    
    <source src="/MusicaFondo.mp3" type="audio/mpeg" />
  </audio>

  <!-- Botón de música flotante -->
<button
    id="btn-musica"
    type="button"
    aria-label="Activar o pausar la música"
    class="fixed bottom-6 left-6 z-[200] w-14 h-14 flex items-center justify-center bg-linear-to-b from-rosa-boton to-rosa backdrop-blur-md border border-white/30 text-white rounded-full shadow-lg shadow-rosa/30 transition-all duration-300 hover:scale-110 active:scale-95 opacity-0 pointer-events-none"
  >
    <svg id="icono-musica" class="w-7 h-7" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"/>
    </svg>
  </button>

  <!-- Pantalla inicial: sobre digital -->
<div
    id="pantalla-sobre"
    class="fixed inset-0 z-[100] bg-paper flex flex-col items-center justify-center transition-all duration-1000 ease-in-out"
  >
    <button
      id="btn-abrir-sobre"
      type="button"
      class="relative cursor-pointer hover:scale-105 transition-transform duration-500 animate-pulse-lento flex flex-col items-center"
    >
      <img
        src="/Sobre3.jpg"
        alt="Sobre de invitación"
        class="w-[min(18rem,70vw)] h-auto drop-shadow-2xl"
      />
      <span class="block fuente-textos text-sm tracking-[0.2em] uppercase text-gray-500 mt-6 font-semibold">
        Hacé clic para abrir
      </span>
    </button>

    <div class="absolute bottom-16 text-center">
      <h2 class="fuente-titulos text-4xl text-rosa mb-1">Estás invitado</h2>
      <p class="fuente-textos text-xs sm:text-sm tracking-[0.1em] uppercase text-gray-500">
        Hemos reservado tu lugar
      </p>
    </div>
  </div>

  <!-- Lluvia de pétalos (los estilos están en global.css) -->
   {/*
  <div
    class="fixed inset-0 pointer-events-none z-[60] overflow-hidden"
    id="contenedor-petalos"
    style="display: none;"
    aria-hidden="true"
  >
    <div class="petalo"></div>
    <div class="petalo"></div>
    <div class="petalo"></div>
    <div class="petalo"></div>
    <div class="petalo"></div>
  </div>
*/}
  <!-- La invitación real -->
  <main
    class="w-full max-w-md fondo-invitacion rounded-3xl shadow-xl shadow-rosa/15 overflow-hidden flex-col text-center relative z-[50]"
    id="contenido-invitacion"
    style="display: none;"
  >
    {secciones.map((Seccion, i) => (
      <>
        {i > 0 && Seccion !== Presentacion && <Divider />}
        <Seccion />
      </>
    ))}
  </main>

</BaseLayout>

<script>
  // Sobre, música y pétalos. En el paso 3 lo separamos en componentes propios.
  document.addEventListener('DOMContentLoaded', () => {
    const pantallaSobre = document.getElementById('pantalla-sobre');
    const btnAbrir = document.getElementById('btn-abrir-sobre');
    const cuerpoPagina = document.body;
    const contenidoInvitacion = document.getElementById('contenido-invitacion');
    const contenedorPetalos = document.getElementById('contenedor-petalos');

    const audio = document.getElementById('musica-fondo') as HTMLAudioElement;
    const btnMusica = document.getElementById('btn-musica') as HTMLButtonElement;
    const iconoMusica = document.getElementById('icono-musica') as HTMLElement;
    let musicaReproduciendo = false;
    // Solo en desarrollo (npm run dev): saltea el sobre para ver los cambios rápido.
    // En el build de producción (Vercel) esto no se ejecuta.

    if (btnAbrir && pantallaSobre && contenidoInvitacion) {
      btnAbrir.addEventListener('click', () => {

        contenidoInvitacion.style.display = 'flex';
        if (contenedorPetalos) contenedorPetalos.style.display = 'block';

        pantallaSobre.classList.add('sobre-abierto');

        btnMusica?.classList.remove('opacity-0', 'pointer-events-none');
        btnMusica?.classList.add('opacity-100');

        if (audio) {
          audio.play().then(() => {
            musicaReproduciendo = true;
            iconoMusica?.classList.add('disco-girando');
            btnMusica?.classList.add('bg-[#4c1d95]/60');
            btnMusica?.classList.remove('bg-gray-400/60');
          }).catch(() => {
            console.log('Autoplay bloqueado por el navegador, el usuario debe interactuar primero.');
            btnMusica?.classList.add('bg-gray-400/60');
            btnMusica?.classList.remove('bg-[#4c1d95]/60');
          });
        }

        setTimeout(() => {
          pantallaSobre.style.display = 'none';
          cuerpoPagina.classList.remove('overflow-hidden');
        }, 1000);

      });
    }

    if (btnMusica && audio) {
      btnMusica.addEventListener('click', () => {
        if (musicaReproduciendo) {
          audio.pause();
          iconoMusica?.classList.remove('disco-girando');
          btnMusica?.classList.add('bg-gray-400/60', 'opacity-80');
          btnMusica?.classList.remove('bg-[#4c1d95]/60');
        } else {
          audio.play();
          iconoMusica?.classList.add('disco-girando');
          btnMusica?.classList.remove('bg-gray-400/60', 'opacity-80');
          btnMusica?.classList.add('bg-[#4c1d95]/60');
        }
        musicaReproduciendo = !musicaReproduciendo;
      });
    }
  });
</script>