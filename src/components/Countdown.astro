---
// src/components/Countdown.astro
// Cuenta regresiva hasta la fecha y hora de data/boda.ts (fecha.iso).
import { boda } from '../data/boda';

const unidades = [
  { clave: 'dias', etiqueta: 'Días' },
  { clave: 'horas', etiqueta: 'Horas' },
  { clave: 'minutos', etiqueta: 'Min' },
  { clave: 'segundos', etiqueta: 'Seg' },
];
---

<section id="cuenta-regresiva" class="relative w-full overflow-hidden px-6 py-10 text-center">

  <!-- =====================================================
       DECORACIÓN SOBRE LA MANCHA ROSA (z-0: detrás del texto)
       ===================================================== -->
  <img
    src="Esquina1.png"
    alt=""
    aria-hidden="true"
    class="pointer-events-none absolute bottom-26 left-0 z-0 w-[21%] max-w-48 select-none"
  />

  <!-- =====================================================
       CONTENIDO (z-10: por encima de la decoración)
       ===================================================== -->
  <div class="relative z-10">

    <h2
      data-reveal
      class="mt-4 font-body font-ui text-xl font-semibold uppercase tracking-[0.25em] text-malva"
    >
      Faltan
    </h2>

    <div
      data-reveal
      style="--reveal-delay: 150ms"
      data-fecha={boda.fecha.iso}
      role="timer"
      aria-label="Cuenta regresiva para la boda"
      class="mt-4 flex items-start justify-center"
    >
      {unidades.map((u, i) => (
        <>
          {i > 0 && (
            <span
              aria-hidden="true"
              class="px-1.5 font-body text-4xl leading-none text-rosa sm:px-1 sm:text-5xl"
            >
              :
            </span>
          )}
          <div class="flex flex-col items-center">
            <span
              data-unidad={u.clave}
              class="min-w-[2ch] font-body text-6xl font-medium leading-none text-rosa sm:text-5xl"
            >
              00
            </span>
            <span class="mt-2 font-body text-base text-rosa/75">{u.etiqueta}</span>
          </div>
        </>
      ))}
    </div>

  </div>

</section>

<script>
  const contenedor = document.querySelector<HTMLElement>('#cuenta-regresiva [data-fecha]');

  if (contenedor) {
    // La fecha ISO trae la zona horaria (-03:00), así que funciona igual
    // sin importar desde dónde la abra cada invitado.
    const objetivo = new Date(contenedor.dataset.fecha ?? '').getTime();

    const celda = (clave: string) =>
      contenedor.querySelector<HTMLElement>(`[data-unidad="${clave}"]`);
    const dias = celda('dias');
    const horas = celda('horas');
    const minutos = celda('minutos');
    const segundos = celda('segundos');

    const dosDigitos = (n: number) => String(n).padStart(2, '0');

    function actualizar() {
      const diferencia = Math.max(0, objetivo - Date.now());

      if (dias) dias.textContent = dosDigitos(Math.floor(diferencia / 86_400_000));
      if (horas) horas.textContent = dosDigitos(Math.floor((diferencia % 86_400_000) / 3_600_000));
      if (minutos) minutos.textContent = dosDigitos(Math.floor((diferencia % 3_600_000) / 60_000));
      if (segundos) segundos.textContent = dosDigitos(Math.floor((diferencia % 60_000) / 1000));
    }

    if (!Number.isNaN(objetivo)) {
      actualizar();
      setInterval(actualizar, 1000);
    }
  }
</script>