---
// src/components/Divider.astro
// Divisor floral entre secciones. La imagen se configura en data/boda.ts
// (imagenes.divisor), así que si la cambiás ahí cambia en toda la invitación.
import { boda } from '../data/boda';

interface Props {
  class?: string;
}

const { class: clase = '' } = Astro.props;
---

<div data-reveal class:list={['flex justify-center py-4', clase]} aria-hidden="true">
  <img
    src={boda.imagenes.divisor}
    alt=""
    class="w-40 select-none"
    loading="lazy"
    decoding="async"
  />
</div>