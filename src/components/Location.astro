---
// src/components/Location.astro
// Ceremonia: hora, lugar, botón al mapa y foto del lugar. Los datos salen de data/boda.ts
import { boda } from '../data/boda';

const { hora, lugar, localidad, mapa } = boda.ceremonia;
const fotoLugar = boda.imagenes.lugar;
---

<section id="ubicacion" class="w-full px-8 py-10 text-center">

  <!-- Título: Cormorant Garamond xl -->
<h2
  data-reveal
  class="font-ui text-xl font-semibold uppercase tracking-[0.25em] text-malva"
  >
    Ceremonia:
  </h2>

  <!-- Hora: número grande, como el del calendario y la cuenta regresiva -->
  <p
    data-reveal
    style="--reveal-delay: 100ms"
    class="mt-6 font-body text-6xl font-medium leading-none text-rosa sm:text-6xl"
  >
    {hora} hs
  </p>

  <!-- Lugar: subtítulo y descripción en Montserrat -->
  <div data-reveal style="--reveal-delay: 200ms" class="mt-8">
    <h3 class="font-ui text-xs font-semibold uppercase tracking-[0.2em] text-malva">Lugar</h3>
    <p class="mt-3 font-ui text-base text-malva">{lugar}</p>
    <p class="mt-1 font-ui text-xs tracking-[0.05em] text-malva/80">{localidad}</p>
  </div>

  <!-- Botón al mapa, con la manito que sobresale como en la referencia -->
  <a
    data-reveal
    style="--reveal-delay: 300ms"
    href={mapa}
    target="_blank"
    rel="noopener noreferrer"
    class="relative mt-6 inline-flex items-center justify-center rounded-full bg-rosa-boton px-10 py-3 font-ui text-xs font-semibold uppercase tracking-[0.2em] text-white shadow-md transition-all duration-300 hover:scale-105 active:scale-95"
  >
    Ver ubicación
    <svg
      class="absolute -bottom-4 -right-3 size-8 -rotate-12 text-white drop-shadow-[0_1px_1.5px_rgb(138_84_112/0.8)]"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.75"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M22 14a8 8 0 0 1-8 8" />
      <path d="M18 11v-1a2 2 0 0 0-2-2a2 2 0 0 0-2 2" />
      <path d="M14 10V9a2 2 0 0 0-2-2a2 2 0 0 0-2 2v1" />
      <path d="M10 9.5V4a2 2 0 0 0-2-2a2 2 0 0 0-2 2v10" />
      <path d="M18 11a2 2 0 1 1 4 0v3a8 8 0 0 1-8 8h-2c-2.8 0-4.5-.86-5.99-2.34l-3.6-3.6a2 2 0 0 1 2.83-2.82L7 15" />
    </svg>
  </a>

  <!-- Foto del lugar -->
  <figure
    data-reveal
    class="mx-auto mt-10 max-w-xs overflow-hidden rounded-2xl shadow-md shadow-rosa/20"
  >
    <img
      src={fotoLugar}
      alt={`Vista de ${lugar}`}
      class="aspect-[7/5] w-full object-cover"
      loading="lazy"
      decoding="async"
    />
  </figure>

</section>