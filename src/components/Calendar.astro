---
// src/components/Calendar.astro
// Calendario del mes de la boda. Todo se calcula desde la fecha de data/boda.ts:
// para otra boda no hay que tocar este archivo.
import { boda } from '../data/boda';

const { novio, novia } = boda.novios;
const { lugar, localidad } = boda.ceremonia;

// ---- Fecha de la boda (hora de Argentina) ----
const zona = 'America/Argentina/Buenos_Aires';
const fecha = new Date(boda.fecha.iso);
const [anio, mes, diaBoda] = fecha
  .toLocaleDateString('en-CA', { timeZone: zona }) // "2027-01-08"
  .split('-')
  .map(Number);

// ---- Armado del mes (semana que empieza en domingo) ----
const nombreMes = new Date(Date.UTC(anio, mes - 1, 1)).toLocaleDateString('es-AR', {
  month: 'long',
  timeZone: 'UTC',
});
const diasSemana = ['D', 'L', 'M', 'M', 'J', 'V', 'S'];
const diasVacios = Array.from({ length: new Date(Date.UTC(anio, mes - 1, 1)).getUTCDay() });
const dias = Array.from({ length: new Date(Date.UTC(anio, mes, 0)).getUTCDate() }, (_, i) => i + 1);

// ---- Enlace para agendar en Google Calendar ----
const duracionHoras = 8; // cuánto dura el evento en la agenda
const fin = new Date(fecha.getTime() + duracionHoras * 60 * 60 * 1000);
const formatoGoogle = (d: Date) => d.toISOString().replace(/[-:]|\.\d{3}/g, ''); // 20270108T230000Z

const googleCalendarUrl =
  'https://calendar.google.com/calendar/render?action=TEMPLATE' +
  `&text=${encodeURIComponent(`Boda de ${novio} y ${novia}`)}` +
  `&dates=${formatoGoogle(fecha)}/${formatoGoogle(fin)}` +
  `&details=${encodeURIComponent('¡Acompañanos a celebrar nuestra boda!')}` +
  `&location=${encodeURIComponent(`${lugar}, ${localidad}`)}`;
---

<section id="calendario" class="relative w-full overflow-hidden px-8 py-10 text-center">

  <!-- =====================================================
       DECORACIÓN SOBRE LA MANCHA ROSA (z-0: sobre el fondo, detrás del contenido)
       ===================================================== -->
  <img
    src="Esquina1.png"
    alt=""
    aria-hidden="true"
    class="pointer-events-none absolute right-0 top-50 z-0 w-[28%] max-w-52 -scale-x-100 select-none"
  />

  <!-- =====================================================
       CONTENIDO (z-10: queda por encima de la decoración)
       ===================================================== -->
  <div class="relative z-10">

    <h2
      data-reveal
      class="mt-4 font-body font-ui text-xl font-semibold uppercase tracking-[0.25em] text-malva"
    >
      {nombreMes} {anio}
    </h2>

    <div
      data-reveal
      style="--reveal-delay: 150ms"
      role="group"
      aria-label={`Calendario de ${nombreMes} de ${anio}`}
      class="mx-auto mt-6 max-w-[19rem] rounded-3xl border border-rosa/40 bg-white/50 p-4 shadow-sm"
    >
      <!-- Días de la semana -->
      <div class="grid grid-cols-7 font-body text-lg font-medium text-rosa/80" aria-hidden="true">
        {diasSemana.map((d) => <span>{d}</span>)}
      </div>

      <!-- Números del mes -->
      <div class="mt-3 grid grid-cols-7 gap-y-2 font-body text-xl font-medium text-malva">
        {diasVacios.map(() => <span></span>)}

        {dias.map((dia) => (
          <span class="flex h-9 items-center justify-center">
            {dia === diaBoda ? (
              <span
                class="relative flex size-10 items-center justify-center text-white"
                aria-label={`${dia} de ${nombreMes}, día de la boda`}
              >
                <svg
                  class="absolute inset-0 size-full text-rosa-boton"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" />
                </svg>
                <span class="relative pt-0.5">{dia}</span>
              </span>
            ) : (
              dia
            )}
          </span>
        ))}
      </div>
    </div>

    <!-- Botón para agendar (idéntico al de sugerencia musical) -->
    <a
      data-reveal
      style="--reveal-delay: 300ms"
      href={googleCalendarUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-8 inline-flex items-center justify-center gap-2 rounded-full bg-linear-to-b from-rosa-boton to-rosa px-14 py-3 font-ui text-xs font-semibold uppercase tracking-[0.25em] text-white shadow-lg shadow-rosa/30 transition-all duration-300 hover:scale-105 active:scale-95"
    >
      <svg class="size-4 fill-none stroke-current" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
        <line x1="16" y1="2" x2="16" y2="6"></line>
        <line x1="8" y1="2" x2="8" y2="6"></line>
        <line x1="3" y1="10" x2="21" y2="10"></line>
      </svg>
      Agendar fecha
    </a>

  </div>
</section>