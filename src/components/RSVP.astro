---
// src/components/RSVP.astro
// Confirmación de asistencia: guarda la respuesta en una planilla de Google
// y abre WhatsApp con el mensaje armado. Los datos salen de data/boda.ts.
import { boda } from '../data/boda';

const urlSheet = boda.sheets.invitados;
const telefonoNovio = boda.whatsapp.novio;
const telefonoNovia = boda.whatsapp.novia;
const fechaLimite = boda.confirmarAntesDe;

// Clases que se repiten (ahora idénticas al campo principal, sin uppercase ni tracking extra en placeholder)
const clasesCampo =
  'w-full rounded-xl border border-rosa/30 bg-white px-4 py-3 font-ui text-sm text-malva shadow-sm placeholder:text-sm placeholder:text-malva/50 focus:border-rosa focus:outline-none focus:ring-2 focus:ring-rosa/30 aria-invalid:border-red-400';

const clasesAsistencia =
  'flex-1 rounded-xl border-2 border-rosa-boton/70 bg-white py-2.5 font-ui text-[11px] font-semibold uppercase tracking-[0.15em] text-rosa shadow-sm transition-colors aria-pressed:border-rosa-boton aria-pressed:bg-rosa-boton aria-pressed:text-white';

const clasesEnviar =
  'w-full rounded-full bg-linear-to-b from-rosa-boton to-rosa py-3 font-ui text-xs font-semibold uppercase tracking-[0.2em] text-white shadow-lg shadow-rosa/30 transition-all duration-300 hover:scale-[1.02] active:scale-95';
---

<section
  id="rsvp"
  data-sheet={urlSheet}
  data-tel-novio={telefonoNovio}
  data-tel-novia={telefonoNovia}
  class="relative w-full overflow-hidden px-8 py-10 text-center"
>

  <!-- =====================================================
       DECORACIÓN: ESQUINA SUPERIOR DERECHA (z-0: detrás del contenido)
       ===================================================== -->
  <img
    src="Esquina1.png"
    alt=""
    aria-hidden="true"
    class="pointer-events-none absolute right-0 -top-0 z-0 w-[26%] max-w-48 -scale-x-100 select-none"
  />

  <!-- =====================================================
       CONTENIDO (z-10: por encima de la decoración)
       ===================================================== -->
  <div class="relative z-10">

    <!-- Ícono: sobre abierto -->
    <div data-reveal class="mx-auto size-12 text-rosa-boton" aria-hidden="true">
      <svg
        class="size-full"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.25"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M21.2 8.4c.5.38.8.97.8 1.6v10a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V10a2 2 0 0 1 .8-1.6l8-6a2 2 0 0 1 2.4 0l8 6Z" />
        <path d="m22 10-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 10" />
      </svg>
    </div>

    <!-- Título: Cormorant Garamond xl -->
    <h2
      data-reveal
      style="--reveal-delay: 100ms"
      class="mt-4 font-body font-ui text-xl font-semibold uppercase tracking-[0.25em] text-malva"
    >
      Confirma tu asistencia
    </h2>

    <!-- Descripción: Montserrat -->
    <p
      data-reveal
      style="--reveal-delay: 150ms"
      class="mt-3 font-ui text-base text-malva"
    >
      Agradecemos que confirmes tu asistencia antes del 31 de Diciembre
    </p>

    <div data-reveal style="--reveal-delay: 250ms" class="mx-auto mt-8 flex max-w-xs flex-col gap-4">

      <!-- Nombre del invitado -->
      <div>
        <label for="nombre-invitado" class="sr-only">tu nombre y apellido</label>
        <input
          id="nombre-invitado"
          type="text"
          required
          maxlength="120"
          autocomplete="off"
          placeholder="Nombre y apellido"
          class={`${clasesCampo} mt-3`}
        />
      </div>

      <!-- Acá el script agrega los campos de los acompañantes -->
      <div id="nombres-extra" class="flex flex-col gap-2"></div>

      <!-- Asistencia -->
      <div class="mt-2 flex gap-3">
        <button id="btn-si" type="button" aria-pressed="false" class={clasesAsistencia}>
          Sí, asistiré
        </button>
        <button id="btn-no" type="button" aria-pressed="false" class={clasesAsistencia}>
          No asistiré
        </button>
      </div>

      <!-- Número de acompañantes (se oculta si no asiste) -->
      <div id="bloque-acompanantes" class="relative" hidden>
        <label for="acompanantes" class="sr-only">número de acompañantes</label>
        <select
          id="acompanantes"
          class={`${clasesCampo} appearance-none text-xs uppercase tracking-[0.15em]`}
        >
          <option value="" disabled selected>Número de acompañantes</option>
          <option value="0">Ninguno (voy solo/a)</option>
          <option value="1">1 acompañante</option>
          <option value="2">2 acompañantes</option>
          <option value="3">3 acompañantes</option>
        </select>
        <svg
          class="pointer-events-none absolute inset-y-0 right-4 my-auto size-4 text-rosa"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="m6 9 6 6 6-6" />
        </svg>
      </div>

      <div class="my-2 h-px w-full bg-rosa/25" aria-hidden="true"></div>

      <!-- Envío -->
      <button id="enviar-novio" type="button" class={clasesEnviar}>Enviar al novio</button>
      <button id="enviar-novia" type="button" class={clasesEnviar}>Enviar a la novia</button>

      <p id="aviso-rsvp" role="status" class="min-h-5 font-ui text-xs text-rosa"></p>
    </div>

  </div>

  <!-- Molde de los campos de acompañantes (el script lo copia) -->
  <template id="plantilla-acompanante">
    <input type="text" autocomplete="off" maxlength="80" class={clasesCampo} />
  </template>

</section>

<script>
  const seccion = document.getElementById('rsvp');
  const campoNombre = document.getElementById('nombre-invitado') as HTMLInputElement | null;
  const btnSi = document.getElementById('btn-si');
  const btnNo = document.getElementById('btn-no');
  const bloqueAcompanantes = document.getElementById('bloque-acompanantes');
  const selectAcompanantes = document.getElementById('acompanantes') as HTMLSelectElement | null;
  const contenedorExtra = document.getElementById('nombres-extra');
  const plantilla = document.getElementById('plantilla-acompanante') as HTMLTemplateElement | null;
  const aviso = document.getElementById('aviso-rsvp');

  if (
    seccion && campoNombre && btnSi && btnNo && bloqueAcompanantes &&
    selectAcompanantes && contenedorExtra && plantilla && aviso
  ) {
    let asiste: boolean | null = null;

    type Datos = { nombre: string; acompanantes: string[] };

    const mostrarAviso = (texto: string, esError = false) => {
      aviso.textContent = texto;
      aviso.classList.toggle('text-red-500', esError);
      aviso.classList.toggle('text-rosa', !esError);
    };

    // Dibuja un campo de nombre por cada acompañante elegido (con estilo identico y en minusculas)
    const dibujarAcompanantes = () => {
      contenedorExtra.innerHTML = '';
      if (!asiste) return;

      const cantidad = parseInt(selectAcompanantes.value, 10);
      if (Number.isNaN(cantidad)) return;

      for (let i = 1; i <= cantidad; i++) {
        const molde = plantilla.content.firstElementChild as HTMLInputElement;
        const campo = molde.cloneNode(true) as HTMLInputElement;
        campo.placeholder = `Nombre del acompañante ${i}`;
        campo.setAttribute('aria-label', `Nombre del acompañante ${i}`);
        contenedorExtra.appendChild(campo);
      }
    };

    const elegirAsistencia = (valor: boolean) => {
      asiste = valor;
      btnSi.setAttribute('aria-pressed', String(valor));
      btnNo.setAttribute('aria-pressed', String(!valor));
      bloqueAcompanantes.hidden = !valor;
      dibujarAcompanantes();
      mostrarAviso('');
    };

    // Lee y valida el formulario. Devuelve null si falta algo.
    const leerFormulario = (): Datos | null => {
      const nombre = campoNombre.value.trim();
      if (asiste === null) {
        mostrarAviso('Elegí si asistirás o no.', true);
        btnSi.focus();
        return null;
      }

      if (!asiste) return { nombre, acompanantes: [] };

      if (selectAcompanantes.value === '') {
        mostrarAviso('Elegí el número de acompañantes.', true);
        selectAcompanantes.focus();
        return null;
      }

      const campos = Array.from(contenedorExtra.querySelectorAll<HTMLInputElement>('input'));
      let faltan = false;
      campos.forEach((campo) => {
        const vacio = !campo.value.trim();
        campo.setAttribute('aria-invalid', String(vacio));
        if (vacio) faltan = true;
      });

      if (faltan) {
        mostrarAviso('Completá el nombre de todos tus acompañantes.', true);
        return null;
      }

      return { nombre, acompanantes: campos.map((campo) => campo.value.trim()) };
    };

    const armarMensaje = (datos: Datos) => {
      if (!asiste) {
        return `¡Hola! Soy ${datos.nombre}. Lamentablemente no podré asistir a la boda. ¡Les deseo lo mejor!`;
      }

      const asistentes = [datos.nombre, ...datos.acompanantes];
      const total = asistentes.length;
      const cantidad = total === 1 ? 'Iré solo/a. ' : `Seremos un total de ${total} personas. `;

      return `¡Hola! Confirmamos nuestra asistencia a la boda. ${cantidad}Asistentes: ${asistentes.join(', ')}.`;
    };

    const enviar = (telefono: string) => {
      const datos = leerFormulario();
      if (!datos) return;

      // Las columnas de la planilla: nombre, asiste, cantidad, acompanantes
      const params = new URLSearchParams({
        nombre: datos.nombre,
        asiste: asiste ? 'Sí' : 'No',
        cantidad: asiste ? String(1 + datos.acompanantes.length) : '0',
        acompanantes: asiste && datos.acompanantes.length > 0 ? datos.acompanantes.join(', ') : '-',
      });

      // 1. A Google Sheets, de fondo ('keepalive' evita que se corte al abrir WhatsApp)
      fetch(seccion.dataset.sheet ?? '', {
        method: 'POST',
        mode: 'no-cors',
        keepalive: true,
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: params,
      }).catch(() => {});

      // 2. WhatsApp, enseguida (tiene que ir dentro del clic para que no lo bloquee el navegador)
      window.open(`https://wa.me/${telefono}?text=${encodeURIComponent(armarMensaje(datos))}`, '_blank');

      mostrarAviso('¡Gracias! Se abrió WhatsApp para que envíes tu confirmación.');
    };

    btnSi.addEventListener('click', () => elegirAsistencia(true));
    btnNo.addEventListener('click', () => elegirAsistencia(false));
    selectAcompanantes.addEventListener('change', dibujarAcompanantes);

    document.getElementById('enviar-novio')?.addEventListener('click', () => {
      enviar(seccion.dataset.telNovio ?? '');
    });
    document.getElementById('enviar-novia')?.addEventListener('click', () => {
      enviar(seccion.dataset.telNovia ?? '');
    });
  }
</script>