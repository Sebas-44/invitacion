---
// src/components/Photos.astro
// Versículo + galería: la primera foto va grande y las demás en dos columnas.
// Las fotos y el versículo se cambian en data/boda.ts (galeria).
import { boda } from '../data/boda';

const { versiculo, referencia, fotos } = boda.galeria;
---

<section id="fotos" class="w-full px-8 py-10 text-center">

  <!-- Versículo: Montserrat -->
  <div data-reveal>
    <p class="mx-auto max-w-xs font-ui text-[0.85rem] uppercase leading-relaxed tracking-[0.15rem] text-malva">
      {versiculo}
    </p>
    <p class="mt-4 font-ui text-[0.90rem] font-semibold uppercase tracking-[0.15em] text-malva">
      {referencia}
    </p>
    <svg
      class="mx-auto mt-3 size-4 text-rosa-boton"
      viewBox="0 0 24 24"
      fill="currentColor"
      aria-hidden="true"
    >
      <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" />
    </svg>
  </div>

  <!-- Galería: la primera foto ocupa las dos columnas -->
  <div class="mx-auto mt-8 grid max-w-sm grid-cols-2 gap-4">
    {fotos.map((foto, i) => (
      <figure
        data-reveal
        style={`--reveal-delay: ${i * 120}ms`}
        class:list={[
          'overflow-hidden rounded-2xl border-2 border-white/80 shadow-lg shadow-rosa/20',
          i === 0 ? 'col-span-2 aspect-[4/5]' : 'aspect-square',
        ]}
      >
        <img
          src={foto.src}
          alt={foto.alt}
          loading="lazy"
          decoding="async"
          class:list={[
            'size-full object-cover transition-transform duration-700 hover:scale-105',
            i === 0 && 'object-top',
          ]}
        />
      </figure>
    ))}
  </div>

</section>