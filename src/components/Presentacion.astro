---
// src/components/Presentacion.astro
// Presentación de los novios: padres, invitación, nombres y fecha.
// Va justo después de Home (sin Divider en el medio): juntos forman la portada.
import { boda } from '../data/boda';
import SeparadorCorazon from './ui/SeparadorCorazon.astro';

const { novio, novia } = boda.novios;
const { padres } = boda.portada;
const { floresAbajo, divisor } = boda.imagenes;

// Mes, día y año a partir de la fecha de la boda (hora de Argentina)
const fecha = new Date(boda.fecha.iso);
const formato = (opciones: Intl.DateTimeFormatOptions) =>
  fecha.toLocaleDateString('es-AR', { timeZone: 'America/Argentina/Buenos_Aires', ...opciones });
const mes = formato({ month: 'long' });
const dia = formato({ day: 'numeric' });
const anio = formato({ year: 'numeric' });
const diaSemana = formato({ weekday: 'long' });
---

<section id="presentacion" class="relative w-full overflow-hidden px-8 pb-6 pt-6 text-center">

  <!-- =====================================================
       DECORACIONES (z-0: quedan detrás del texto)
       ===================================================== -->

  <!-- Rosas: esquina inferior izquierda -->
  <img
    src={floresAbajo}
    alt=""
    aria-hidden="true"
    class="pointer-events-none absolute bottom-0 left-0 z-0 w-[46%] max-w-52 select-none"
  />

  {/*
    PARA AGREGAR OTRA DECORACIÓN: copiá este bloque, sacale el comentario
    y cambiá el src y la posición.

    <img
      src="/ramita.png"
      alt=""
      aria-hidden="true"
      class="pointer-events-none absolute bottom-24 right-6 z-0 w-14 select-none"
    />

    Posición: top-/bottom- y left-/right- (cada paso son 4px: right-6 = 24px).
    Tamaño: w-14 = 56px. Para espejarla: agregá -scale-x-100.
  */}

  <!-- =====================================================
       CONTENIDO (z-10: queda por encima de las decoraciones)
       ===================================================== -->
  <div class="relative z-10">

    <p data-reveal class="etiqueta mx-auto max-w-72">
      Por la gracia de Dios y la compañía de nuestros padres
    </p>

    <div data-reveal class="mt-7 grid grid-cols-[1fr_auto_1fr] items-center gap-4">
      <p class="etiqueta whitespace-pre-line">{padres.novio}</p>
      <span class="h-12 w-px bg-rosa/40" aria-hidden="true"></span>
      <p class="etiqueta whitespace-pre-line">{padres.novia}</p>
    </div>

    <SeparadorCorazon class="mt-7 w-full" />

    <p data-reveal class="etiqueta mx-auto mt-8 max-w-64 text-rosa">
      Tenemos el agrado de invitarte a nuestra boda:
    </p>

    <!-- Nombres -->
    <h1
      data-reveal
      style="--reveal-delay: 150ms"
      class="mt-10 flex flex-col items-center font-script leading-none text-rosa"
    >
      <span class="text-[6.25rem]">{novio}</span>
      <span class="my-1 flex w-full items-center justify-center gap-4 text-4xl">
        <span class="h-px w-16 bg-rosa/40" aria-hidden="true"></span>
        <span>y</span>
        <span class="h-px w-16 bg-rosa/40" aria-hidden="true"></span>
      </span>
      <span class="text-[6.25rem]">{novia}</span>
    </h1>

    <!-- Fecha -->
    <div data-reveal class="mt-8 flex flex-col items-center text-rosa">
      <p class="font-ui text-sm font-medium uppercase tracking-[0.35em]">{mes}</p>

      <div class="-mt-2 grid w-full grid-cols-[1fr_auto_1fr] items-center gap-4">
        <p class="etiqueta border-y border-rosa/80 py-2 pl-[0.3em] text-xs tracking-[0.3em] text-rosa">
          {diaSemana}
        </p>
        <p class="font-body text-8xl font-medium leading-none">{dia}</p>
        <p class="etiqueta border-y border-rosa/80 py-2 pl-[0.3em] text-xs tracking-[0.3em] text-rosa">
          {anio}
        </p>
      </div>
    </div>

  </div>
</section>