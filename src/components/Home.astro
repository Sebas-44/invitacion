---
// src/components/Home.astro
// Portada de la invitación. Textos, nombres, fecha e imágenes salen de data/boda.ts
import { boda } from '../data/boda';
import SeparadorCorazon from './ui/SeparadorCorazon.astro';

const { novio, novia } = boda.novios;
const { versiculo, referencia, padres } = boda.portada;
const { floresArriba, floresAbajo, divisor, pareja } = boda.imagenes;

const { iniciales } = boda;

// Mes, día y año a partir de la fecha de la boda (hora de Argentina)
const fecha = new Date(boda.fecha.iso);
const formato = (opciones: Intl.DateTimeFormatOptions) =>
  fecha.toLocaleDateString('es-AR', { timeZone: 'America/Argentina/Buenos_Aires', ...opciones });
const mes = formato({ month: 'long' });
const dia = formato({ day: 'numeric' });
const anio = formato({ year: 'numeric' });
const { presentacion } = boda;
---

<section id="inicio" class="relative w-full overflow-hidden pb-2">

  <!-- Rosas: esquina superior derecha -->
  <img
    src={floresArriba}
    alt=""
    aria-hidden="true"
    class="pointer-events-none absolute right-0 top-0 z-0 w-[90%] max-w-96 select-none saturate-120"
  />

  <!-- Versículo + monograma -->
  <header class="relative z-10 flex flex-col items-center px-8 pt-52 text-center">

    <p class="etiqueta mx-auto max-w-xs !text-[0.75rem] leading-relaxed">
      {versiculo}
      <span class="mt-1 block text-[0.75rem] tracking-[0.15em]">{referencia}</span>
    </p>

  <p
    data-reveal
    style="--reveal-delay: 150ms"
    role="img"
    aria-label={`${iniciales.novio} y ${iniciales.novia}`}
    class="mt-2 flex items-end justify-center font-body font-medium leading-none text-rosa"
  >
    <span aria-hidden="true" class="text-[8.5rem]">{iniciales.novio}</span>
    <span aria-hidden="true" class="mx-2 mb-3 font-script text-4xl">y</span>
    <span aria-hidden="true" class="text-[8.5rem]">{iniciales.novia}</span>
  </p>

    <SeparadorCorazon class="mt-4 w-64" />
  </header>

  <!-- Foto con borde de papel rasgado (arriba y abajo) -->
  <figure data-reveal class="relative mt-10 drop-shadow-[0_1px_3px_rgb(196_86_107/0.3)]">
    <div class="foto-rasgada aspect-[7/8.5] w-full">
      <img
        src={pareja}
        alt={`Foto de ${novio} y ${novia}`}
        class="size-full object-cover"
        decoding="async"
      />
    </div>
  </figure>

  <!-- Divisor floral: se superpone al borde inferior de la foto -->
  <img
    src={divisor}
    alt=""
    aria-hidden="true"
    class="relative z-10 mx-auto -mt-1 w-44 select-none"
  />


</section>